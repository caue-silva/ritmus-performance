# Copie para .env.local e preencha.
# Local: rode `npx supabase start` e use os valores de `npx supabase status -o env`
# (API_URL, PUBLISHABLE_KEY e SECRET_KEY). Produção: Supabase → Project Settings → API Keys.

# URL do projeto Supabase (pública)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Chave publicável (pública; o acesso real é controlado pelo RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Chave secreta (service role). SÓ NO SERVIDOR. Usada para criar/redefinir contas
# da equipe e para o formulário público de cadastro. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Endereço público do app (usado para montar o link de cadastro enviado no WhatsApp)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
